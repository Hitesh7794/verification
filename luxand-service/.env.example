# Luxand FaceSDK service configuration.
#
# Copy this file to ".env" and fill in the real values. ".env" is in
# .gitignore so the key never reaches a commit.
#
# Three ways to run the service:
#
# (a) Docker — recommended for local dev on macOS / Apple Silicon:
#     docker compose up --build
#     (compose reads this .env automatically)
#
# (b) Bare JVM on a Linux host (production / EC2):
#     export $(grep -v '^#' .env | xargs)
#     java -Djna.library.path=$(pwd)/native/linux-x86_64 \
#          -jar target/luxand-service-1.0.0.jar
#
# (c) FSDK_LICENSE_FILE — point at a path containing the key. Useful when
#     the secret comes from a vault that mounts a file:
#     FSDK_LICENSE_FILE=/run/secrets/luxand  java -jar ...

# ── Luxand FaceSDK License ────────────────────────────────────────────────
FSDK_LICENSE_KEY=PUT-YOUR-LUXAND-KEY-HERE

# Listen port. Loopback-only by design.
FACE_PORT=8040

# False Accept Rate target. The service translates this to a similarity
# threshold via FSDK.GetMatchingThresholdAtFAR at startup. Lower FAR = stricter
# match. 0.0001 = 1 wrong match per 10 000 trials, the industry standard
# for ID verification.
FACE_MATCH_FAR=0.0001
