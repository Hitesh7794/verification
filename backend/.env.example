# backend/.env — populate, then `cp .env.example .env` and edit.
# This file is for documentation; .env (the real one) is gitignored.
#
# Run the backend with these env vars set, e.g.:
#   export $(grep -v '^#' .env | xargs)
#   ./cmd/server
# or in systemd via EnvironmentFile=/etc/neet-verification/backend.env.

# ── Core ─────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
DATABASE_URL=postgres://portal:portal-dev@127.0.0.1:5434/verification?sslmode=disable
JWT_SECRET=change-this-in-production

# ── TrustView hosted compare API (replaces on-prem matchers) ────────────
# Single endpoint for face + iris + fingerprint 1:1 compare. Backend
# forwards probe + gallery bytes plus a Bearer token; API returns a
# unified 0..100 score (50 = threshold).
# TRUSTVIEW_TOKEN empty = biometric compare endpoints return 503 (the
# rest of the API stays up). Token expires — rotate here when TrustView
# emails a new one.
TRUSTVIEW_BASE_URL=https://v1.trustview.in
TRUSTVIEW_TOKEN=

# ── Razorpay test-mode wallet (Phase 6) ──────────────────────────────────
# Get these from https://dashboard.razorpay.com/ → Settings → API Keys
# (Test Mode). The KEY_ID is sent to the browser; the SECRET stays
# server-side and is the HMAC key for verifying payment signatures.
# Both empty = wallet endpoints return 503 + the candidate-lookup charge
# is bypassed (deployment runs unchanged).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Per-deployment wallet tuning. All amounts in paise (₹1 = 100 paise).
# Fee charged per /api/candidates/{roll} lookup for client-role users.
# 500 = ₹5 / lookup. Set to 0 to disable wallet charging entirely.
WALLET_FEE_PER_LOOKUP_PAISE=500
# Maximum single Razorpay top-up; ₹50,000 default.
WALLET_MAX_DEPOSIT_PAISE=5000000
# If the same client searches the same roll within this many minutes,
# no additional charge. Set to 0 to disable the cache.
WALLET_SAME_ROLL_CACHE_MIN=5

# ── Outbound email (SMTP) ────────────────────────────────────────────────
# SMTP_HOST empty = falls back to console logger (dev). Works with any
# STARTTLS SMTP relay — only the host/port/user/pass change between
# providers (Gmail / Office 365 / AWS SES SMTP / Zoho / Resend / ...).
#
# For Gmail: enable 2-Step Verification on the SMTP_USER account, then
# generate an App Password at https://myaccount.google.com/apppasswords
# Don't use your regular Gmail login password — App Passwords are
# specifically scoped to SMTP/IMAP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Verification Portal <noreply@example.com>

# ── Outbound SMS (AuthKey.io) ────────────────────────────────────────────
# AuthKey SMS OTP integration for verifying mobile numbers.
AUTHKEY_SMS_KEY=877f65eb773cee5d
AUTHKEY_SMS_SID=44529
AUTHKEY_SMS_COMPANY=seQRview
AUTHKEY_SMS_COUNTRY_CODE=91
AUTHKEY_SMS_URL=https://api.authkey.io/request

