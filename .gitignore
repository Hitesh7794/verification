TECH_LEAD_QUESTIONS.md

# Vendor Marvis Auth Web SDK — Windows-native iris daemon. Not
# redistributable; ~200 MB. Drop into client-bootstrap/windows/vendor/
# before running install.ps1 (or build-bundle.sh will stage it there).
# See client-bootstrap/windows/vendor/README.md for the download link.
client-bootstrap/windows/vendor/MarvisAuthClientService*.exe

# IriTech / Mantra IriShield (MIS100V2) USB driver installer. Vendor
# .exe, ~90 MB. Same rules as the Marvis SDK — not redistributable via
# git; drop into vendor/ before build. Covers VID 1F63 PID F001 which
# Mantra's MYUSB driver does NOT install.
client-bootstrap/windows/vendor/MIS100V2_Driver*.exe

# Mantra MorFin fingerprint USB driver installer. Vendor .exe, ~19 MB
# (v1.5.0.0). Same rules — not redistributable, drop into vendor/
# before build. Covers Mantra fp devices (VID 2C0F).
client-bootstrap/windows/vendor/MorFinDriver*.exe

# Luxand SDK + license: never commit. Vendor terms forbid redistribution
# of the SDK; the license key is per-deployment and confidential.
Luxand_FaceSDK_Linux_8_3/
Luxand_FaceSDK_Wrappers_8_3/
hardwareid_Linux/
luxand-service/lib/FaceSDK.jar
luxand-service/lib/jna-*.jar
luxand-service/native/
.env
.env.local
*.license
license.key

# Build outputs
**/target/
**/dist/
backend/verification.db*
node_modules/
# Bundle ZIPs that escape dist/ — build-bundle.sh sometimes writes one
# level up than expected (the windows zip lands at client-bootstrap/...
# instead of client-bootstrap/windows/dist/). Gitignored at any path
# defensively so a stray copy is never accidentally committed.
*.zip

# Third-party Windows service registrar. BSD-licensed, but treated like
# a vendor binary: not committed, downloaded from nssm.cc per
# client-bootstrap/windows/README.md. Mirrors the Marvis JAR pattern.
client-bootstrap/windows/tools/nssm.exe

# Bundled Adoptium Temurin JRE 17. Re-fetched by build-bundle.sh from
# Adoptium's release API on each build (cached locally). ~42 MB
# compressed, ~130 MB extracted — Adoptium's license permits
# redistribution but we don't want it in git history. The unpacked
# tree lands at client-bootstrap/windows/dist/.../morfin/jre/ when
# build-bundle.sh runs.
client-bootstrap/windows/.cache/
client-bootstrap/windows/dist/*/morfin/jre/

# Inno Setup compile output — the OperatorPortalSetup-X.Y.Z.exe lives
# under installer/output/ after build.cmd runs on Windows. The .iss
# source and supporting files (license.txt, build.cmd, README.md)
# are tracked; the compiled .exe is a build artefact (~250 MB).
client-bootstrap/windows/installer/output/

# ACPL vendor packages — both the L1 RD Service (Aadhaar) and the
# Capture API (1:1 local matching for Startek FM220U / AST300). Vendor-
# supplied, downloaded from acpl.in.net; not redistributable as part of
# this repo. Re-download locally when working on the Startek fingerprint
# integration (see STARTEK_INTEGRATION.md).
ACPL_L1_RD_Linux_Desktop_*/
ACPL_L1_RD_Support_Tool/
ACPL_L1_RD_Windows_*/
Setup_ACPL_L1_API/
L1_API_Setup_*.msi
L1_RD_Intrgration_Guide*.pdf
L1_RD_Integration_Guide*.pdf
*Linux_RD_User_Guide*.pdf
*Fingerprint*API*Guide*.pdf
*ACPL*.pdf

# Defense-in-depth: never accidentally commit private keys
*.pem
*.key
id_rsa*
id_ed25519*

# Razorpay API key downloads — Razorpay's dashboard ships keys as CSV files
# with timestamps in the name. Pattern-match them so an accidental
# download into the repo doesn't get committed. Same logic: the real
# values live in backend/.env (which is already gitignored via `.env`).
razorpay_*api_keys*.csv
razorpay_*api_keys*.txt
*razorpay*.csv

# Operator install bundles served by the admin Downloads page. Built
# artefacts (zip today, signed .exe later) are large and reproducible
# from client-bootstrap/windows/build-bundle.sh — drop them into this
# dir at deploy time, never commit.
backend/downloads/
/downloads/
**/downloads/

# OS / editor / build noise
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*.tar.gz
# Runtime caches generated by the backend
backend/face_templates/
**/face_templates/
# Uploaded institution registration documents — local-filesystem
# storage, contains head-of-institution PII (PAN scans, signed
# authorization letters). Never commit.
backend/institution_docs/
**/institution_docs/
backend/artifacts/institution_docs/
# Stray local mvn repo dirs (from -Dmaven.repo.local typos)
**/C:*/

# Backups of .env — historical credentials, never commit
**/.env.bak.*

# Vendor Windows binaries — not redistributable
MorFinDriver_*.exe

# Claude Code session workspaces (local scratch)
.claude/

# Production DB snapshots pulled for local inspection — real PII, never commit
backend/_prod_snapshot/
