# Data Plane env file — rendered by scripts/multi-tenant/add-dp.sh
# for DP slug "__SLUG__".
#
# Placeholders replaced at render time:
#   __SLUG__               short identifier, e.g. "nta"
#   __PORT__               local bind port, e.g. "8092"
#   __PUBLIC_BASE_URL__    HTTPS URL this DP is reachable at
#   __DATABASE_URL__       Postgres DSN pointing at this DP's own database
#   __JWT_SECRET__         freshly generated per-DP secret (32 bytes hex)
#   __INTERNAL_API_KEY__   freshly generated per-DP secret (32 bytes hex)
#   __CONTROL_PLANE_URL__  where the CP is reachable from this box
#   __DP_CLIENT_ID__       clients_registry.id after CP registration
#   __DP_API_KEY__         clients_registry.api_key echoed once from CP
#
# Values NOT in this template (Razorpay, SMTP, TrustView, S3, etc.) are
# copied verbatim from the source DP's .env so a new DP inherits the
# same billing/mail/verification providers by default. Override in this
# file after render if you want per-DP billing.

APP_ENV=production
HTTP_ADDR=127.0.0.1:__PORT__
PUBLIC_BASE_URL=__PUBLIC_BASE_URL__
ALLOWED_ORIGINS=__PUBLIC_BASE_URL__

# ── Per-DP database (dedicated PG database on the shared RDS instance) ─
DATABASE_URL=__DATABASE_URL__

# ── Per-DP secrets ────────────────────────────────────────────────────
# JWT_SECRET is per-DP so a token issued by DP-A is REJECTED by DP-B.
# Cross-tenant token leaks are impossible by construction.
JWT_SECRET=__JWT_SECRET__

# INTERNAL_API_KEY gates /api/internal/* on this DP. The CP holds the
# SAME value in clients_registry.api_key for this DP's row.
INTERNAL_API_KEY=__INTERNAL_API_KEY__

# ── Talking back to the Control Plane ─────────────────────────────────
# When SERVE_KYC_LOCALLY=false this DP reverse-proxies its /register
# and /reviewer/applications endpoints to the CP below.
CONTROL_PLANE_URL=__CONTROL_PLANE_URL__
DATA_PLANE_CLIENT_ID=__DP_CLIENT_ID__
DATA_PLANE_API_KEY=__DP_API_KEY__

# Start with KYC handled locally. Flip to false only after the wizard
# fully proxies (see the register-wizard gap in the status doc).
SERVE_KYC_LOCALLY=true

# ── Per-DP local storage ──────────────────────────────────────────────
DATA_DIR=/opt/verificationportal-__SLUG__/data
ARTIFACT_DIR=/opt/verificationportal-__SLUG__/artifacts
DOWNLOADS_DIR=/opt/verificationportal-__SLUG__/downloads

# ── Shared providers (INHERITED from source DP — override to split) ───
# The following are filled in by add-dp.sh by copying from the source
# DP's .env verbatim. Nothing to do here at render time; see the
# INHERITED block appended below by the script.
