[Unit]
Description=mantra-iris-service (Marvis SDK wrapper, localhost:8031)
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/local/mantra-iris-service
# IRIS_PROVIDER=marvis-strict requires the real Marvis SDK at runtime.
# If the JAR can't be loaded the process exits non-zero and systemd's
# Restart=on-failure surfaces the failure. The alternative ("marvis")
# falls back to a mock and would silently emit fake scores from a
# healthy-looking service — a far worse outcome than a failing unit.
Environment=IRIS_PROVIDER=marvis-strict
Environment=IRIS_PORT=8031
# `java -cp` rather than `java -jar`: the iris service jar's manifest
# Main-Class is fine, but `java -jar` ignores anything outside that one
# jar's own classpath. Marvis_Auth.jar lives next to our jar (the .deb
# drops both into /usr/local/mantra-iris-service/) and is loaded
# reflectively by MarvisIrisProvider, so it MUST be on the classpath at
# launch — otherwise Class.forName("com.mantra.marvisauth.MarvisAuth")
# throws ClassNotFoundException, marvis-strict mode exits non-zero, and
# systemd flags the unit as failed.
ExecStart=/usr/bin/java -cp /usr/local/mantra-iris-service/mantra-iris-service.jar:/usr/local/mantra-iris-service/Marvis_Auth.jar com.veni.irisservice.Main
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
