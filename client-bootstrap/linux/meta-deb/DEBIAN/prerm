#!/bin/bash
# prerm for verification-portal-client. Removes the browser-policy
# JSON files we wrote in postinst. The daemon services themselves are
# managed by their own packages — we don't touch those.
set -e

for f in \
  /etc/opt/chrome/policies/managed/verification-portal.json \
  /etc/chromium/policies/managed/verification-portal.json \
  /etc/chromium-browser/policies/managed/verification-portal.json \
  /usr/lib/firefox/defaults/pref/autoconfig.js \
  /usr/lib/firefox/verification-portal.cfg
do
  [ -f "$f" ] && rm -f "$f"
done

exit 0
